{
	// vitest transpiles without type-checking, so the compile-time assertions in
	// tests/client-plugin-types.test.ts are only enforced by `bun run typecheck`.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": ".",
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["src/**/*", "tests/**/*", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}
