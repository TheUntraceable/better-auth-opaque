	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"better-auth": "^1.7.6",
		"express": "^5.2.1",
		"morgan": "^1.12.1",
		"typescript": "^7.0.2",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"better-auth": "^1.7.0",
		"typescript": ">=5",
		"zod": "^4"
	},
	"dependencies": {
		"@serenity-kit/opaque": "^0.9.0"
	}
}
