{
	"name": "better-auth-opaque",
	"version": "3.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build && npm test",
		"test": "bunx --bun vitest run",
		"test:timing": "cross-env OPAQUE_TIMING_TESTS=1 bunx --bun vitest run tests/timing/ --no-file-parallelism",
		"test:server": "bun tests/server.ts",
		"test:node": "vitest run"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"better-auth": "1.7.14",
		"cross-env": "^10.1.0",
		"express": "^5.2.1",
		"morgan": "^1.12.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"better-auth": "^1.7.0",
		"zod": "^4"
	},
	"dependencies": {
		"@serenity-kit/opaque": "^0.9.0"
	},
	"sideEffects": false
}
